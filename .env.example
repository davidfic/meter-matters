# Copy to .env for a local run, or set these in your host's secret store.
# Anything left unset switches its feature off; nothing else breaks.

# --- required when hosted -----------------------------------------------------
# Signs session cookies. Setting it is what turns accounts on.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ELEC_SECRET_KEY=
# The address people reach the app at. https:// also marks cookies Secure.
ELEC_BASE_URL=https://bills.example.com

# --- where the data lives -----------------------------------------------------
# Postgres - required on Cloud Run, which has no disk. For Supabase use the
# "Transaction pooler" connection string (port 6543) from Project Settings.
# ELEC_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Or, on a host with a disk: one directory, one volume.
# ELEC_DATA_DIR=/data
# ELEC_ALLOW_SIGNUP=0          # close sign-ups once your people are in
# ELEC_TRUSTED_PROXIES=1       # proxies in front of the app; 0 if there are none

# --- way in: forwarding -------------------------------------------------------
# ELEC_INBOUND_DOMAIN=in.example.com
# ELEC_INBOUND_SECRET=         # for a raw/Cloudflare or Postmark webhook
# ELEC_MAILGUN_SIGNING_KEY=    # for Mailgun
# ELEC_INBOUND_DKIM=warn       # off | warn | require

# --- way in: Google (sign-in, and connecting Gmail) ---------------------------
# ELEC_GOOGLE_CLIENT_ID=
# ELEC_GOOGLE_CLIENT_SECRET=
# Encrypts a kept Gmail token. Without it only one-time imports are offered.
#   python secrets_box.py
# ELEC_TOKEN_KEY=

# --- the recurring check: pick one --------------------------------------------
# ELEC_SCHEDULER=1             # the app runs it daily itself (one always-on instance)
# ELEC_TASK_TOKEN=             # or: a scheduler POSTs /api/tasks/check with this

# --- weather (taking it out of the comparison with last year) -----------------
# On by default, through Open-Meteo: free for non-commercial use, no key.
# Sends a ZIP code and a town's rounded position; never an address.
# ELEC_WEATHER=off

# --- email to users (missing bills, new bills) --------------------------------
# ELEC_SMTP_HOST=smtp.example.com
# ELEC_SMTP_USER=
# ELEC_SMTP_PASS=
# ELEC_SMTP_FROM=bills@example.com
