# Copy to deploy/cloudrun.env. Settings that are not secret; one KEY=value per line.
# Secrets are stored with  ./deploy/cloudrun.sh secrets  instead.

# The address people use. Your own domain if you map one, else the run.app URL.
ELEC_BASE_URL=https://elec-bill-xxxxxxxx.a.run.app

