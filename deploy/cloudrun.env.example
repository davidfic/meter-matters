# ELEC_INBOUND_DKIM=warn
# ELEC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# ELEC_SMTP_HOST=smtp.example.com
# ELEC_SMTP_USER=
# ELEC_SMTP_FROM=bills@example.com
